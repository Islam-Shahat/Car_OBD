{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "OBD Diagnose",
  "version": "0.9.0-rc.1",
  "identifier": "com.obdscan.diagnose",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "OBD Diagnose",
        "width": 1180,
        "height": 780,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost https:"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE2MkJEMDIyMDNGQzM3MTYKUldUbndhU21SVEg0Q0lUYWN3N2N5c1QyNmtSWHpxTXhOc0x5clJmUkFmK29FMTB3T1R0aVBaTncK",
      "endpoints": ["https://github.com/Islam-Shahat/Car_OBD/releases/latest/download/latest.json"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
